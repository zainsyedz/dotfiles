#!/usr/bin/env bash
set -euo pipefail

resolve_herdr_bin() {
  local candidate="${HERDR_BIN_PATH:-}"
  candidate="${candidate% (deleted)}"
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  if command -v herdr >/dev/null 2>&1; then
    command -v herdr
    return 0
  fi
  for p in /usr/bin/herdr "$HOME/.local/bin/herdr"; do
    if [ -x "$p" ]; then
      printf '%s\n' "$p"
      return 0
    fi
  done
  printf '%s\n' "${candidate:-herdr}"
}
herdr_bin="$(resolve_herdr_bin)"

cwd=$("$herdr_bin" pane current 2>/dev/null | jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty')
if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
  cwd=${PWD:-$HOME}
fi

cd "$cwd"
exec lazygit
