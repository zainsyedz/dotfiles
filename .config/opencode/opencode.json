{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "contributing.md",
    "guidelines.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "DO-k8s": {
      "type": "remote",
      "url": "https://doks.mcp.digitalocean.com/mcp",
      "headers": {
        "Authorization": "${DIGITALOCEAN_MCP_TOKEN}"
      },
      "enabled": false
    }
  },
}
