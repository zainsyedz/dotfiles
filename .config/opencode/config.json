{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["contributing.md", "guidelines.md"],
  "keybinds": {
    "messages_page_up" : "ctrl+f",
    "messages_page_down": "ctrl+b",
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
      "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-21c80711-3652-44b4-b970-fe94b8a76979"
      },
      "enabled": true
    }
  }
}
