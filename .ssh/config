Host github.com
	Hostname github.com
	IdentityFile ~/.ssh/personal_key
	IdentitiesOnly yes
	AddKeysToAgent yes
Host *.zystem
	Hostname %h
	IdentityFile ~/.ssh/personal_key
	IdentitiesOnly yes
	AddKeysToAgent yes
Host *
	PubkeyAcceptedAlgorithms +ssh-rsa
	HostkeyAlgorithms +ssh-rsa
	SetEnv TERM=xterm-256color
	ServerAliveInterval 30
	ServerAliveCountMax 3

